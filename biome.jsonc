{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    // Examples are generated by the shadcn CLI (`bun run examples:sync`), so
    // they stay as a developer would receive them.
    "includes": [
      "!examples/nextjs",
      "!examples/vite",
      "!apps/web/public/r",
      "!.install-test",
      "!**/*.svg"
    ]
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      // Inline handlers are the idiomatic React pattern here, and these
      // components are not render hot paths.
      "includes": ["apps/**", "packages/registry/**", "examples/shared/**"],
      "linter": {
        "rules": { "performance": { "noJsxPropsBind": "off" } }
      }
    },
    {
      // Base UI wires each label to its control, and PanelTitle's content comes
      // from its props. The linter can see neither.
      "includes": ["packages/registry/components/**"],
      "linter": {
        "rules": {
          "a11y": { "noLabelWithoutControl": "off", "useHeadingContent": "off" }
        }
      }
    },
    {
      // Scripts and tests run rarely and top to bottom, so readable one-off
      // regular expressions and sequential awaits are the right call.
      "includes": [
        "packages/tooling/**",
        "apps/web/e2e/**",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/vitest.config.ts",
        "packages/registry/test/**"
      ],
      "linter": {
        "rules": {
          "complexity": { "noExcessiveCognitiveComplexity": "off" },
          "performance": { "noAwaitInLoops": "off", "useTopLevelRegex": "off" },
          "style": {
            "useDestructuring": "off",
            "useNamedCaptureGroup": "off",
            "useThisInClassMethods": "off"
          }
        }
      }
    },
    {
      // Examples receive React from whichever app they're copied into.
      "includes": ["examples/shared/**"],
      "linter": {
        "rules": { "correctness": { "noUndeclaredDependencies": "off" } }
      }
    }
  ]
}
